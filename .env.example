# Configurações do Supabase para o Personal Trainer App
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Configuração de Envio 100% Automático de E-mails (Resend - Gratuito até 3.000 e-mails/mês)
# Crie sua chave em: https://resend.com/api-keys
EXPO_PUBLIC_RESEND_API_KEY=
# E-mail de remetente (padrão de testes: Personal Trainer <onboarding@resend.dev>)
EXPO_PUBLIC_SENDER_EMAIL=Personal Trainer <onboarding@resend.dev>
